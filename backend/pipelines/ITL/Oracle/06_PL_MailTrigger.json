{
  "name": "06_PL_MailTrigger",
  "properties": {
    "activities": [
      {
        "name": "To Split",
        "type": "SetVariable",
        "dependsOn": [],
        "typeProperties": {
          "variableName": "to_list",
          "value": {
            "value": "@if(equals(trim(coalesce(pipeline().parameters.recipient_email_to, '')), ''), array(), split(pipeline().parameters.recipient_email_to, ';'))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "To Build",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "To Split",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@variables('to_list')",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "To Append",
              "type": "AppendVariable",
              "dependsOn": [],
              "typeProperties": {
                "variableName": "to_recipients",
                "value": {
                  "value": "@json(concat('{\"emailAddress\":{\"address\":\"', trim(item()), '\"}}'))",
                  "type": "Expression"
                }
              }
            }
          ]
        }
      },
      {
        "name": "Cc Split",
        "type": "SetVariable",
        "dependsOn": [],
        "typeProperties": {
          "variableName": "cc_list",
          "value": {
            "value": "@if(equals(trim(coalesce(pipeline().parameters.recipient_email_cc, '')), ''), array(), split(pipeline().parameters.recipient_email_cc, ';'))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Cc Build",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Cc Split",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@variables('cc_list')",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "Cc Append",
              "type": "AppendVariable",
              "dependsOn": [],
              "typeProperties": {
                "variableName": "cc_recipients",
                "value": {
                  "value": "@json(concat('{\"emailAddress\":{\"address\":\"', trim(item()), '\"}}'))",
                  "type": "Expression"
                }
              }
            }
          ]
        }
      },
      {
        "name": "Bcc Split",
        "type": "SetVariable",
        "dependsOn": [],
        "typeProperties": {
          "variableName": "bcc_list",
          "value": {
            "value": "@if(equals(trim(coalesce(pipeline().parameters.recipient_email_bcc, '')), ''), array(), split(pipeline().parameters.recipient_email_bcc, ';'))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Bcc Build",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Bcc Split",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@variables('bcc_list')",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "Bcc Append",
              "type": "AppendVariable",
              "dependsOn": [],
              "typeProperties": {
                "variableName": "bcc_recipients",
                "value": {
                  "value": "@json(concat('{\"emailAddress\":{\"address\":\"', trim(item()), '\"}}'))",
                  "type": "Expression"
                }
              }
            }
          ]
        }
      },
      {
        "name": "IRIS Mail Trigger",
        "type": "WebActivity",
        "dependsOn": [
          {
            "activity": "To Build",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Cc Build",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Bcc Build",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": true
        },
        "typeProperties": {
          "url": {
            "value": "@concat('https://graph.microsoft.com/v1.0/users/', pipeline().parameters.sender_upn, '/sendMail')",
            "type": "Expression"
          },
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "value": "@concat('{\"message\":{\"subject\":\"', pipeline().parameters.email_subject, '\",\"body\":{\"contentType\":\"Text\",\"content\":\"', pipeline().parameters.email_body, '\"},\"toRecipients\":', string(variables('to_recipients')), ',\"ccRecipients\":', string(variables('cc_recipients')), ',\"bccRecipients\":', string(variables('bcc_recipients')), '},\"saveToSentItems\":\"false\"}')",
            "type": "Expression"
          },
          "authentication": {
            "type": "MSI",
            "resource": "https://graph.microsoft.com"
          }
        }
      }
    ],
    "parameters": {
      "recipient_email_bcc": {
        "type": "string"
      },
      "email_body": {
        "type": "string"
      },
      "recipient_email_cc": {
        "type": "string"
      },
      "recipient_email_to": {
        "type": "string"
      },
      "email_subject": {
        "type": "string"
      },
      "sender_upn": {
        "type": "string",
        "defaultValue": "Replace_Notification_Sender_UPN"
      }
    },
    "variables": {
      "to_list": {
        "type": "Array"
      },
      "cc_list": {
        "type": "Array"
      },
      "bcc_list": {
        "type": "Array"
      },
      "to_recipients": {
        "type": "Array"
      },
      "cc_recipients": {
        "type": "Array"
      },
      "bcc_recipients": {
        "type": "Array"
      }
    }
  }
}