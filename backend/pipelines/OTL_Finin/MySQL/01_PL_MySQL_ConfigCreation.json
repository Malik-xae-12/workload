{
    "name": "01_PL_MySQL_ConfigCreation",

    "properties": {
        "activities": [
            {
                "name": "Information Schema",
                "description": "Uses a copy activity to transfer data from MySQL to the Warehouse's InformationSchema",
                "type": "Copy",
                "dependsOn": [
                    {
                        "activity": "Create Schema",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "source": {
                        "type": "MySqlSource",
                        "query": "SELECT * FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA = DATABASE()",
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None",
                        "datasetSettings": {
                            "annotations": [],
                            "type": "MySqlTable",
                            "schema": [],
                            "typeProperties": {
                                "database": "Replace_Source_Database_Name"
                            },
                            "externalReferences": {
                                "connection": "Replace_Source_Connection_Id"
                            }
                        }
                    },
                    "sink": {
                        "type": "DataWarehouseSink",
                        "allowCopyCommand": true,
                        "writeBehavior": "Insert",
                        "tableOption": "autoCreate",
                        "datasetSettings": {
                            "annotations": [],
                            "linkedService": {
                                "name": "WH_MetaData",
                                "properties": {
                                    "annotations": [],
                                    "type": "DataWarehouse",
                                    "typeProperties": {
                                        "endpoint": "Replace_MetaData_SQL_Endpoint",
                                        "artifactId": "Replace_MetaData_Warehouse_Id",
                                        "workspaceId": "Replace_Workspace_Id"
                                    }
                                }
                            },
                            "type": "DataWarehouseTable",
                            "schema": [],
                            "typeProperties": {
                                "schema": {
                                    "value": "@variables('ConfigSchemaName')",
                                    "type": "Expression"
                                },
                                "table": "SourceInformationSchema"
                            }
                        }
                    },
                    "enableStaging": true,
                    "translator": {
                        "type": "TabularTranslator",
                        "typeConversion": true,
                        "typeConversionSettings": {
                            "allowDataTruncation": true,
                            "treatBooleanAsNumber": false
                        }
                    }
                }
            },
            {
                "name": "Create Schema",
                "description": "Executes a script to create the Config schema",
                "type": "Script",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "linkedService": {
                    "name": "WH_MetaData",
                    "properties": {
                        "annotations": [],
                        "type": "DataWarehouse",
                        "typeProperties": {
                            "endpoint": "Replace_MetaData_SQL_Endpoint",
                            "artifactId": "Replace_MetaData_Warehouse_Id",
                            "workspaceId": "Replace_Workspace_Id"
                        }
                    }
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "type": "Query",
                            "text": {
                                "value": "@concat('CREATE SCHEMA ' ,variables('ConfigSchemaName'))",
                                "type": "Expression"
                            }
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00"
                }
            },
            {
                "name": "Wait for Process Completion",
                "description": "Introduces a wait activity to allow time for prior activities to complete before proceeding with the next steps.",
                "type": "Wait",
                "dependsOn": [
                    {
                        "activity": "Primary Key",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "waitTimeInSeconds": 10
                }
            },
            {
                "name": "Process Metadata",
                "description": "Executes the metadata processing notebook to generate dynamic SQL queries, transform the data, and load the processed metadata into the centralized configuration table.",
                "type": "TridentNotebook",
                "dependsOn": [
                    {
                        "activity": "Wait for Process Completion",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "notebookId": "Replace_OTLMetaData_Creation_Id",
                    "workspaceId": "Replace_Workspace_Id",
                    "parameters": {
                        "ConfigSchemaName": {
                            "value": {
                                "value": "@variables('ConfigSchemaName')",
                                "type": "Expression"
                            },
                            "type": "string"
                        }
                    }
                }
            },
            {
                "name": "Key Constraint Config",
                "description": "Uses a copy activity to transfer foreign key metadata from MySQL to the Warehouse's InformationSchema",
                "type": "Copy",
                "dependsOn": [
                    {
                        "activity": "Information Schema",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "source": {
                        "type": "MySqlSource",
                        "query": "SELECT\n    kcu.CONSTRAINT_NAME AS FK_Name,\n    kcu.TABLE_SCHEMA AS FK_Schema,\n    kcu.TABLE_NAME AS FK_Table,\n    kcu.COLUMN_NAME AS FK_Column,\n    kcu.REFERENCED_TABLE_SCHEMA AS Referenced_Schema,\n    kcu.REFERENCED_TABLE_NAME AS Referenced_Table,\n    kcu.REFERENCED_COLUMN_NAME AS Referenced_Column\nFROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE kcu\nWHERE kcu.REFERENCED_TABLE_NAME IS NOT NULL\n    AND kcu.TABLE_SCHEMA = DATABASE()\nORDER BY FK_Schema, FK_Table;",
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None",
                        "datasetSettings": {
                            "annotations": [],
                            "type": "MySqlTable",
                            "schema": [],
                            "typeProperties": {
                                "database": "Replace_Source_Database_Name"
                            },
                            "externalReferences": {
                                "connection": "Replace_Source_Connection_Id"
                            }
                        }
                    },
                    "sink": {
                        "type": "DataWarehouseSink",
                        "allowCopyCommand": true,
                        "writeBehavior": "Insert",
                        "tableOption": "autoCreate",
                        "datasetSettings": {
                            "annotations": [],
                            "linkedService": {
                                "name": "WH_MetaData",
                                "properties": {
                                    "annotations": [],
                                    "type": "DataWarehouse",
                                    "typeProperties": {
                                        "endpoint": "Replace_MetaData_SQL_Endpoint",
                                        "artifactId": "Replace_MetaData_Warehouse_Id",
                                        "workspaceId": "Replace_Workspace_Id"
                                    }
                                }
                            },
                            "type": "DataWarehouseTable",
                            "schema": [],
                            "typeProperties": {
                                "schema": {
                                    "value": "@variables('ConfigSchemaName')",
                                    "type": "Expression"
                                },
                                "table": "KeyConstraintConfig"
                            }
                        }
                    },
                    "enableStaging": true,
                    "translator": {
                        "type": "TabularTranslator",
                        "typeConversion": true,
                        "typeConversionSettings": {
                            "allowDataTruncation": true,
                            "treatBooleanAsNumber": false
                        }
                    }
                }
            },
            {
                "name": "Primary Key",
                "description": "Uses a copy activity to transfer primary key metadata from MySQL to the Warehouse's InformationSchema",
                "type": "Copy",
                "dependsOn": [
                    {
                        "activity": "Key Constraint Config",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "source": {
                        "type": "MySqlSource",
                        "query": "SELECT\n    KU.TABLE_SCHEMA,\n    KU.TABLE_NAME,\n    KU.COLUMN_NAME\nFROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS TC\nJOIN INFORMATION_SCHEMA.KEY_COLUMN_USAGE KU\n    ON TC.CONSTRAINT_NAME = KU.CONSTRAINT_NAME\n    AND TC.TABLE_SCHEMA = KU.TABLE_SCHEMA\n    AND TC.TABLE_NAME = KU.TABLE_NAME\nWHERE TC.CONSTRAINT_TYPE = 'PRIMARY KEY'\n    AND TC.TABLE_SCHEMA = DATABASE()\nORDER BY KU.TABLE_SCHEMA, KU.TABLE_NAME, KU.ORDINAL_POSITION;",
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None",
                        "datasetSettings": {
                            "annotations": [],
                            "type": "MySqlTable",
                            "schema": [],
                            "typeProperties": {
                                "database": "Replace_Source_Database_Name"
                            },
                            "externalReferences": {
                                "connection": "Replace_Source_Connection_Id"
                            }
                        }
                    },
                    "sink": {
                        "type": "DataWarehouseSink",
                        "allowCopyCommand": true,
                        "writeBehavior": "Insert",
                        "tableOption": "autoCreate",
                        "datasetSettings": {
                            "annotations": [],
                            "linkedService": {
                                "name": "WH_MetaData",
                                "properties": {
                                    "annotations": [],
                                    "type": "DataWarehouse",
                                    "typeProperties": {
                                        "endpoint": "Replace_MetaData_SQL_Endpoint",
                                        "artifactId": "Replace_MetaData_Warehouse_Id",
                                        "workspaceId": "Replace_Workspace_Id"
                                    }
                                }
                            },
                            "type": "DataWarehouseTable",
                            "schema": [],
                            "typeProperties": {
                                "schema": {
                                    "value": "@variables('ConfigSchemaName')",
                                    "type": "Expression"
                                },
                                "table": "PrimaryKeyConfig"
                            }
                        }
                    },
                    "enableStaging": true,
                    "translator": {
                        "type": "TabularTranslator",
                        "typeConversion": true,
                        "typeConversionSettings": {
                            "allowDataTruncation": true,
                            "treatBooleanAsNumber": false
                        }
                    }
                }
            }
        ],
        "variables": {
            "ConfigSchemaName": {
                "type": "String",
                "defaultValue": "Replace_ConfigSchemaName"
            }
        }
    }
}